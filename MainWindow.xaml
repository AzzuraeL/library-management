<Window x:Class="LibraryManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Management"
        Height="750"
        Width="1050"
        MinHeight="620"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= FORM ================= -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <TextBlock Text="LIBRARY MANAGEMENT"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- Control 1: TextBox ISBN -->
                <TextBlock Text="ISBN"/>
                <TextBox x:Name="txtIsbn"
                         Height="35"
                         Margin="0,5,0,15"
                         VerticalContentAlignment="Center"/>

                <!-- Control 2: TextBox Judul Buku -->
                <TextBlock Text="Judul Buku"/>
                <TextBox x:Name="txtJudul"
                         Height="35"
                         Margin="0,5,0,15"
                         VerticalContentAlignment="Center"/>

                <!-- Control 3: TextBox Pengarang -->
                <TextBlock Text="Pengarang"/>
                <TextBox x:Name="txtPengarang"
                         Height="35"
                         Margin="0,5,0,15"
                         VerticalContentAlignment="Center"/>

                <!-- Control 4: ComboBox Kategori -->
                <TextBlock Text="Kategori"/>
                <ComboBox x:Name="cmbKategori"
                          Height="35"
                          Margin="0,5,0,15"
                          VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Fiksi"/>
                    <ComboBoxItem Content="Non-Fiksi"/>
                    <ComboBoxItem Content="Sains &amp; Teknologi"/>
                    <ComboBoxItem Content="Sejarah"/>
                    <ComboBoxItem Content="Biografi"/>
                    <ComboBoxItem Content="Pendidikan"/>
                </ComboBox>

                <!-- Control 5: RadioButton Status -->
                <TextBlock Text="Status Buku"/>
                <StackPanel Orientation="Horizontal"
                            Margin="0,5,0,15">
                    <RadioButton x:Name="rbTersedia"
                                 Content="Tersedia"
                                 Margin="0,0,20,0"/>
                    <RadioButton x:Name="rbDipinjam"
                                 Content="Dipinjam"/>
                </StackPanel>

                <!-- Control 6: DatePicker Tanggal Terbit -->
                <TextBlock Text="Tanggal Terbit"/>
                <DatePicker x:Name="dpTanggalTerbit"
                            Height="35"
                            Margin="0,5,0,15"
                            VerticalContentAlignment="Center"/>

                <!-- Control 7: TextBox Penerbit -->
                <TextBlock Text="Penerbit"/>
                <TextBox x:Name="txtPenerbit"
                         Height="35"
                         Margin="0,5,0,15"
                         VerticalContentAlignment="Center"/>

                <!-- Control 8: TextBox Deskripsi (multiline) -->
                <TextBlock Text="Deskripsi"/>
                <TextBox x:Name="txtDeskripsi"
                         Height="70"
                         Margin="0,5,0,20"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

                <!-- Control 9: Buttons -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnSimpan"
                            Content="Simpan"
                            Width="120"
                            Height="40"
                            Margin="0,0,10,0"
                            Click="BtnSimpan_Click"/>
                    <Button Content="Reset"
                            Width="120"
                            Height="40"
                            Click="BtnReset_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= DATA ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="DATA BUKU"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- Level 2: Search -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Cari (ISBN / Judul / Pengarang / Kategori)"/>
                <TextBox x:Name="txtSearch"
                         Height="35"
                         Margin="0,5,0,0"
                         VerticalContentAlignment="Center"
                         TextChanged="TxtSearch_TextChanged"/>
            </StackPanel>

            <!-- Control 10: ListBox data buku -->
            <ListBox x:Name="lstBuku"
                     Grid.Row="2"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding Judul}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Detail}"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Level 2: Counter -->
            <TextBlock x:Name="lblJumlah"
                       Grid.Row="3"
                       Text="Jumlah Buku: 0"
                       FontWeight="SemiBold"
                       Margin="0,10,0,0"/>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        Margin="0,10,0,0">
                <!-- Event 4: Edit (Click) -->
                <Button Content="Edit"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="BtnEdit_Click"/>
                <!-- Event 5: Hapus (Click) -->
                <Button Content="Hapus"
                        Width="120"
                        Height="40"
                        Click="BtnHapus_Click"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
